#!/bin/sh
# NOTE: becomes emulationstation
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
MOUNTEDTMP=$( mount | grep "rootfs.ext2" )
#echo $MOUNTEDTMP >> /mnt/SDCARD/log.txt
if [ "${MOUNTEDTMP}" = "" ]; then
#    echo "NOT YET MOUNTED" >> /mnt/SDCARD/log.txt
    MOUNTED=0
else 
#    echo "ALREADY MOUNTED" >> /mnt/SDCARD/log.txt
    MOUNTED=1
fi

PLATFORM="m21"
FWNAME=MinUI
SDCARD_PATH="/mnt/SDCARD"
UPDATE_PATH="${SDCARD_PATH}/MinUI.zip"
SYSTEM_PATH="${SDCARD_PATH}/.system"

export LD_LIBRARY_PATH=${SDCARD_PATH}/${PLATFORM}/libmusl:$LD_LIBRARY_PATH
export SDL_NOMOUSE=1
#export NEWDTB=0

CPU_PATH=/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor
#echo performance > "$CPU_PATH"
PID=-1
# install/update
# is there an update available?
if [ -f ${SDCARD_PATH}/My${FWNAME}-*-${PLATFORM}.zip ]; then
        NEWFILE=$(ls ${SDCARD_PATH}/My${FWNAME}-*-${PLATFORM}.zip)
#	echo "Trovato release file" >> $SDCARD_PATH/log.txt
#	echo "Sono nella directory " $(pwd) >> $SDCARD_PATH/log.txt

	if [ -d "${SYSTEM_PATH}/${PLATFORM}" ]; then
	    ACTION="updating"
	else
	    ACTION="installing"
	fi
	${SDCARD_PATH}/${PLATFORM}/binmusl/show.elf ${SDCARD_PATH}/${PLATFORM}/$ACTION.png 60 &
	PID=$!
#	echo $PID >>  ${SDCARD_PATH}/ciao.txt
	#echo "Found Release file $NEWFILE ! ACTION = $ACTION" >> $LOGFILE
        ${SDCARD_PATH}/${PLATFORM}/binmusl/unzip -o $NEWFILE -d $SDCARD_PATH -x "m21/*" #&>> $LOGFILE
	sync

	#remove useless dirs
#	rm -rf $SDCARD_PATH/rg35xx
	rm -rf $SDCARD_PATH/trimui
#	rm -rf $SDCARD_PATH/miyoo354
	rm -rf $NEWFILE
	sync
#	echo "Finita fase 1" >> $SDCARD_PATH/log.txt
	
fi


#same as original MinUI install/update process
if [ -f "$UPDATE_PATH" ]; then

	if [ $PID -eq -1 ]; then
		if [ -d "${SYSTEM_PATH}/${PLATFORM}" ]; then
		    ACTION="updating"
		else
		    ACTION="installing"
		fi
		${SDCARD_PATH}/${PLATFORM}/binmusl/show.elf ${SDCARD_PATH}/${PLATFORM}/$ACTION.png 60 &
		PID=$!
	fi
	#echo "Found Release file $NEWFILE ! ACTION = $ACTION" >> $LOGFILE
    ${SDCARD_PATH}/${PLATFORM}/binmusl/unzip -o $UPDATE_PATH -d $SDCARD_PATH #&>> $LOGFILE
	sync
	# the updated system finishes the install/update
	rm -rf ${UPDATE_PATH}
	$SYSTEM_PATH/$PLATFORM/bin/install.sh
fi

if [ $PID -ne -1 ];then
    kill -3 $PID
fi

ROOTFS_MOUNTPOINT=/overlay
ROOTFS_IMG=${SYSTEM_PATH}/${PLATFORM}/rootfs.ext2

if [ "${MOUNTED}" = "0" ]; then
    ${SDCARD_PATH}/${PLATFORM}/binmusl/fuse2fs ${ROOTFS_IMG} ${ROOTFS_MOUNTPOINT} 2&> /dev/null
    sync
fi
#ls -l ${ROOTFS_MOUNTPOINT}/* >> /mnt/SDCARD/ls.txt && sync
if [ -f ${ROOTFS_MOUNTPOINT}/bin/busybox ]; then
    rm -rf ${ROOTFS_MOUNTPOINT}/tmp/*
    mkdir -p ${ROOTFS_MOUNTPOINT}/mnt/SDCARD
    if [ ! -f ${ROOTFS_MOUNTPOINT}/etc/asound.conf ]; then
	cp /etc/asound.conf ${ROOTFS_MOUNTPOINT}/etc/asound.conf
	chmod 666 ${ROOTFS_MOUNTPOINT}/etc/asound.conf
	sync
    fi

    if [ ! -f ${ROOTFS_MOUNTPOINT}/etc/fb.modes ]; then
	cp $SDCARD_PATH/fb.modes ${ROOTFS_MOUNTPOINT}/etc/fb.modes
	chmod 666 ${ROOTFS_MOUNTPOINT}/etc/fb.modes
	sync
    fi


    if [ "${MOUNTED}" = "0" ]; then
	#mount all other fs as minui on rg35xx og
	for f in dev dev/pts dev/usb-ffs/adb proc sys sys/kernel/debug sys/kernel/config mnt/SDCARD tmp
	do
		mount -o bind /${f} ${ROOTFS_MOUNTPOINT}/${f}
	done
	cp -f /bin/adbd ${ROOTFS_MOUNTPOINT}/bin/adbd 2>/dev/null
	cp -f /lib/libc.so ${ROOTFS_MOUNTPOINT}/lib/ld-musl-armhf.so.1 2>/dev/null
	ln -sf /lib/ld-musl-armhf.so.1 ${ROOTFS_MOUNTPOINT}/lib/libc.so 2>/dev/null
	(
		while :; do
			if ! ps | grep -v grep | grep -q "adbd"; then
				/bin/adbd -D >/dev/null 2>&1 &
			fi
			sleep 2
		done
	) &
	# Force enable Allwinner sunxi USB Device mode & ADB gadget
	USB_LOG="${SDCARD_PATH}/usb_adb_debug.log"
	echo "=== USB ADB Init ===" > "$USB_LOG"
	for usbc in /sys/devices/platform/soc*/*usbc0* /sys/bus/platform/devices/*usbc0*; do
		if [ -e "$usbc/usb_device" ]; then
			echo "Found usbc0 at $usbc" >> "$USB_LOG"
			cat "$usbc/usb_null" >> "$USB_LOG" 2>&1
			usleep 300000
			cat "$usbc/usb_device" >> "$USB_LOG" 2>&1
			usleep 500000
			break
		fi
	done
	[ -e /sys/kernel/config/usb_gadget/g1/UDC ] && echo "" > /sys/kernel/config/usb_gadget/g1/UDC 2>/dev/null
	killall -9 adbd 2>/dev/null
	BOOT_USB_MODE="adb_only"
	if [ -f "/mnt/SDCARD/.userdata/m21/usb_boot_mode.cfg" ]; then
		BOOT_USB_MODE=$(head -n 1 "/mnt/SDCARD/.userdata/m21/usb_boot_mode.cfg" | tr -d "\r\n ")
	fi
	echo "Boot USB mode: $BOOT_USB_MODE" >> "$USB_LOG"
	if [ "$BOOT_USB_MODE" != "off" ]; then
		/bin/setusbconfig adb >> "$USB_LOG" 2>&1
		/bin/adbd -D >> /tmp/adb.log 2>&1 &
		if [ "$BOOT_USB_MODE" = "adb_ums_rw" ] || [ "$BOOT_USB_MODE" = "adb_ums_ro" ]; then
			G="/sys/kernel/config/usb_gadget/g1"
			mkdir -p "$G/functions/ffs.ums" /dev/usb-ffs/ums 2>/dev/null
			moung_check=$(grep "/dev/usb-ffs/ums" /proc/mounts)
			[ -z "$moung_check" ] && mount -t functionfs ums /dev/usb-ffs/ums
			cp -f "/mnt/SDCARD/Tools/m21/USB Mode.pak/umsd.elf" /tmp/umsd.elf 2>/dev/null
			chmod +x /tmp/umsd.elf 2>/dev/null
			DISK_DEV="/dev/mmcblk0"
			[ -b "/dev/mmcblk0p1" ] && DISK_DEV="/dev/mmcblk0p1"
			RO_FLAG=""
			[ "$BOOT_USB_MODE" = "adb_ums_ro" ] && RO_FLAG="--ro"
			mkdir -p ${ROOTFS_MOUNTPOINT}/dev/usb-ffs/ums 2>/dev/null
			grep -q "${ROOTFS_MOUNTPOINT}/dev/usb-ffs/ums" /proc/mounts || mount -o bind /dev/usb-ffs/ums ${ROOTFS_MOUNTPOINT}/dev/usb-ffs/ums
			chroot ${ROOTFS_MOUNTPOINT} /tmp/umsd.elf /dev/usb-ffs/ums "$DISK_DEV" --exit-on-eject $RO_FLAG >/tmp/umsd.log 2>&1 &
			sleep 1
			echo "" > "$G/UDC" 2>/dev/null
			ln -sf "$G/functions/ffs.ums" "$G/configs/c.1/ffs.ums" 2>/dev/null
		else
			sleep 1
		fi
		# optional USB network: 2nd line of usb_boot_mode.cfg == "net"; type (ecm|ncm|rndis) in usb_nettype
		BOOT_USB_NET=0
		BOOT_NETTYPE=ecm
		if [ -f "/mnt/SDCARD/.userdata/m21/usb_nettype" ]; then
			BOOT_NETTYPE=$(head -n 1 /mnt/SDCARD/.userdata/m21/usb_nettype | tr -d "\r\n ")
		fi
		case "$BOOT_NETTYPE" in ecm|ncm|rndis) ;; *) BOOT_NETTYPE=ecm ;; esac
		if [ -f "/mnt/SDCARD/.userdata/m21/usb_boot_mode.cfg" ] && [ "$(sed -n 2p /mnt/SDCARD/.userdata/m21/usb_boot_mode.cfg | tr -d '\r\n ')" = "net" ]; then
			G="/sys/kernel/config/usb_gadget/g1"
			UP="/mnt/SDCARD/Tools/m21/USB Mode.pak"
			echo "" > "$G/UDC" 2>/dev/null
			lsmod | grep -q "^u_ether_x" || insmod "$UP/modules/u_ether_x.ko" >> "$USB_LOG" 2>&1
			lsmod | grep -q "^f_${BOOT_NETTYPE}_x" || insmod "$UP/modules/f_${BOOT_NETTYPE}_x.ko" >> "$USB_LOG" 2>&1
			if lsmod | grep -q "^f_${BOOT_NETTYPE}_x"; then
				mkdir -p "$G/functions/${BOOT_NETTYPE}.usb0" 2>/dev/null
				if [ "$BOOT_NETTYPE" = "rndis" ]; then
					echo e0 > "$G/functions/rndis.usb0/class"
					echo 01 > "$G/functions/rndis.usb0/subclass"
					echo 03 > "$G/functions/rndis.usb0/protocol"
				fi
				# interface association descriptors: Windows needs device class EF/02/01
				echo 0xEF > "$G/bDeviceClass"; echo 0x02 > "$G/bDeviceSubClass"; echo 0x01 > "$G/bDeviceProtocol"
				ln -sf "$G/functions/${BOOT_NETTYPE}.usb0" "$G/configs/c.1/${BOOT_NETTYPE}.usb0" 2>/dev/null && BOOT_USB_NET=1
			fi
		fi
		UDC_NAME=$(ls /sys/class/udc 2>/dev/null | head -n 1)
		if [ -n "$UDC_NAME" ]; then
			echo "$UDC_NAME" > /sys/kernel/config/usb_gadget/g1/UDC 2>> "$USB_LOG"
			if [ "$BOOT_USB_NET" = "1" ]; then
				if [ -z "$(cat /sys/kernel/config/usb_gadget/g1/UDC)" ]; then
					echo "${BOOT_NETTYPE} bind failed, falling back" >> "$USB_LOG"
					rm -f "$G/configs/c.1/${BOOT_NETTYPE}.usb0"
					echo 0x00 > "$G/bDeviceClass"; echo 0x00 > "$G/bDeviceSubClass"; echo 0x00 > "$G/bDeviceProtocol"
					echo "$UDC_NAME" > /sys/kernel/config/usb_gadget/g1/UDC 2>> "$USB_LOG"
				else
					i=0
					while [ $i -lt 20 ] && ! ifconfig usb0 >/dev/null 2>&1; do usleep 200000; i=$((i+1)); done
					ifconfig usb0 192.168.7.1 netmask 255.255.255.0 up >> "$USB_LOG" 2>&1
					if [ ! -e /mnt/SDCARD/.userdata/m21/usb_noshare ]; then
						ip route replace default via 192.168.7.2 dev usb0 >> "$USB_LOG" 2>&1 || route add default gw 192.168.7.2 usb0 >> "$USB_LOG" 2>&1
						grep -q '^nameserver' /tmp/resolv.conf.auto 2>/dev/null || printf 'nameserver 223.5.5.5\nnameserver 119.29.29.29\nnameserver 8.8.8.8\n' > /tmp/resolv.conf.auto
					fi
					cp -f "$UP/dhcpd_mini.elf" /tmp/dhcpd_mini.elf 2>/dev/null
					chmod +x /tmp/dhcpd_mini.elf 2>/dev/null
					chroot ${ROOTFS_MOUNTPOINT} /tmp/dhcpd_mini.elf usb0 192.168.7.1 192.168.7.2 >/tmp/dhcpd.log 2>&1 &
				fi
			fi
		fi
	fi
	{
		echo "--- /sys/class/udc ---"
		ls -la /sys/class/udc
		echo "--- Gadget UDC ---"
		cat /sys/kernel/config/usb_gadget/g1/UDC
		echo "--- /dev/usb-ffs/adb ---"
		ls -la /dev/usb-ffs/adb
		echo "--- ps adbd ---"
		ps | grep adbd
		echo "--- dmesg usb/udc/otg ---"
		dmesg | grep -iE "usb|udc|otg|gadget|ffs|adb" | tail -n 60
	} >> "$USB_LOG" 2>&1
	sync


    fi
    export PATH=/bin:/sbin:/usr/bin:/usr/sbin
    export LD_LIBRARY_PATH=/usr/lib/:/lib/
    export HOME=$SDCARD_PATH

    cat /dev/zero > /dev/fb0
#evaluate if adding swap file or not

    if [ "${MOUNTED}" = "1" ]; then
		killall -9 launch.sh
		killall -9 keymon.elf
		killall -9 minui.elf
		killall -9 minarch.elf
    fi
	if [ -f "/mnt/SDCARD/m21/thisism22" ]; then
		rm -f /mnt/SDCARD/m21/thisism22
	fi
	if [ "$0" = "/mnt/SDCARD/tomato" ]; then
		echo 1 > /mnt/SDCARD/m21/thisism22
	fi
    chroot $ROOTFS_MOUNTPOINT ${SYSTEM_PATH}/${PLATFORM}/paks/MinUI.pak/launch.sh #&> $SDCARD_PATH/chroot.txt
    sync
fi

#umount ${ROOTFS_MOUNTPOINT}
sync

echo "Exiting" > ${SDCARD_PATH}/bootfailed.txt

sync
halt # under no circumstances should stock be allowed to touch this card
