DEPEND=done


PROG=/sdcard/gameui
export LD_LIBRARY_PATH=/mnt/SDCARD
export MG_CFG_PATH=/usr/share/minigui
/bin/mount /dev/mmcblk0p1 /mnt/SDCARD
/bin/ln -s /mnt/SDCARD /sdcard
/bin/ln -s /sdcard /data
/bin/chmod 7 $PROG
#insmod /lib/mod201.ko
