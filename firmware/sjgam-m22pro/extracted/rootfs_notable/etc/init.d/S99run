BIN="/usr/guimenu"

while [ -f $BIN ]
do
	if [ $(cat /sys/class/gpadc/data) -lt 1030 ] && [ $(cat /sys/class/gpadc/charge) -eq 0 ];then
		   # echo "low pwer $(cat /sys/class/gpadc/data)"
			/usr/bin/lowpower
	fi
	$BIN
	
done