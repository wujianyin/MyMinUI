            assigned-clocks = <0x2 0x7a>;
            assigned-clock-parents = <0x2 0xb>;
            tvd_used = <0x1>;
            tvd_if = <0x0>;
            status = "okay";
            used = <0x1>;
            agc_auto_enable = <0x1>;
            agc_manual_value = <0x40>;
            cagc_enable = <0x1>;
            fliter_used = <0x1>;
            phandle = <0x65>;
        };
        platform@45000004 {
            reg = <0x0 0x45000004 0x0 0x0>;
            eraseflag = <0x1>;
            next_work = <0x3>;
            debug_mode = <0x8>;
        };
        target@45000008 {
            reg = <0x0 0x45000008 0x0 0x0>;
            boot_clock = <0x3f0>;
            storage_type = <0xffffffff>;
            burn_key = <0x1>;
            dragonboard_test = <0x0>;
        };
        card0_boot_para@2 {
            reg = <0x0 0x2 0x0 0x0>;
            device_type = "card0_boot_para";
            card_ctrl = <0x0>;
            card_high_speed = <0x1>;
            card_line = <0x4>;
            pinctrl-0 = <0x1e>;
        };
        card2_boot_para@3 {
            reg = <0x0 0x3 0x0 0x0>;
            device_type = "card2_boot_para";
            card_ctrl = <0x2>;
            card_high_speed = <0x1>;
            card_line = <0x4>;
            pinctrl-0 = <0x1c>;
            sdc_io_1v8 = <0x1>;
            sdc_tm4_hs200_max_freq = <0x96>;
            sdc_tm4_hs400_max_freq = <0x64>;
            sdc_ex_dly_used = <0x2>;
        };
        rfkill@0 {
            compatible = "allwinner,sunxi-rfkill";
            chip_en;
            power_en;
            status = "disabled";
            wlan@0 {
                compatible = "allwinner,sunxi-wlan";
                pinctrl-0 = <0x66>;
                pinctrl-names = "default";
                clock-names = "32k-fanout1";
                clocks = <0x2 0x92>;
                wlan_busnum = <0x1>;
                wlan_regon = <0x13 0x6 0x11 0x0>;
                wlan_hostwake = <0x13 0x6 0xa 0x0>;
                wakeup-source;
            };
            bt@0 {
                compatible = "allwinner,sunxi-bt";
                pinctrl-0 = <0x66>;
                pinctrl-names = "default";
                clock-names = "32k-fanout1";
                clocks = <0x2 0x92>;
                status = "disabled";
            };
        };
        btlpm@0 {
            compatible = "allwinner,sunxi-btlpm";
            uart_index = <0x1>;
            bt_wake = <0x13 0x6 0x10 0x0>;
            bt_hostwake = <0x13 0x6 0x12 0x0>;
            status = "disabled";
        };
        addr_mgt@0 {
            compatible = "allwinner,sunxi-addr_mgt";
            type_addr_wifi = <0x0>;
            type_addr_bt = <0x0>;
            type_addr_eth = <0x0>;
            status = "okay";
        };
        gpio-keys {
            compatible = "gpio-keys";
            autorepeat = <0x1>;
            label = "gpio-keys";
            key0_key {
                label = "key0_key";
                gpios = <0x13 0x6 0x2 0x1>;
                linux,input-type = <0x1>;
                linux,code = <0x126>;
                gpio-key,wakeup;
            };
            key1_key {
                label = "key1_key";
                gpios = <0x13 0x6 0xf 0x1>;
                linux,input-type = <0x1>;
                linux,code = <0x127>;
                gpio-key,wakeup;
            };
            key2_key {
                label = "key2_key";
                gpios = <0x13 0x6 0x7 0x1>;
                linux,input-type = <0x1>;
                linux,code = <0x121>;
                gpio-key,wakeup;
            };
            key3_key {
                label = "key3_key";
                gpios = <0x13 0x6 0xa 0x1>;
                linux,input-type = <0x1>;
                linux,code = <0x120>;
                gpio-key,wakeup;
            };
            key4_key {
                label = "key4_key";
                gpios = <0x13 0x6 0x9 0x1>;
                linux,input-type = <0x1>;
                linux,code = <0x122>;
                gpio-key,wakeup;
            };
            key5_key {
                label = "key5_key";
                gpios = <0x13 0x6 0x8 0x1>;
                linux,input-type = <0x1>;
                linux,code = <0x123>;
                gpio-key,wakeup;
            };
            key6_key {
                label = "key6_key";
                gpios = <0x13 0x6 0x3 0x1>;
                linux,input-type = <0x1>;
                linux,code = <0x67>;
                gpio-key,wakeup;
            };
            key7_key {
                label = "key7_key";
                gpios = <0x13 0x6 0xc 0x1>;
                linux,input-type = <0x1>;
                linux,code = <0x6c>;
                gpio-key,wakeup;
            };
            key8_key {
                label = "key8_key";
                gpios = <0x13 0x6 0x4 0x1>;
                linux,input-type = <0x1>;
                linux,code = <0x69>;
                gpio-key,wakeup;
            };
            key9_key {
                label = "key9_key";
                gpios = <0x13 0x6 0xb 0x1>;
                linux,input-type = <0x1>;
                linux,code = <0x6a>;
                gpio-key,wakeup;
            };
            vol_key {
                label = "vol_key";
                gpios = <0x13 0x6 0xd 0x1>;
                linux,input-type = <0x1>;
                linux,code = <0xb>;
                gpio-key,wakeup;
            };
            vol1_key {
                label = "vol1_key";
                gpios = <0x13 0x6 0x6 0x1>;
                linux,input-type = <0x1>;
                linux,code = <0xc>;
                gpio-key,wakeup;
            };
            select_key {
                label = "select_key";
                gpios = <0x13 0x6 0x11 0x1>;
                linux,input-type = <0x1>;
                linux,code = <0x128>;
                gpio-key,wakeup;
            };
            start_key {
                label = "start_key";
                gpios = <0x13 0x6 0xe 0x1>;
                linux,input-type = <0x1>;
                linux,code = <0x129>;
                gpio-key,wakeup;
            };
            key10_key {
                label = "key10_key";
                gpios = <0x13 0x6 0x5 0x1>;
                linux,input-type = <0x1>;
                linux,code = <0x125>;
                gpio-key,wakeup;
            };
            key11_key {
                label = "key11_key";
                gpios = <0x13 0x1 0x1 0x1>;
                linux,input-type = <0x1>;
                linux,code = <0x124>;
                gpio-key,wakeup;
            };
        };
    };
    vdd-cpu {
        compatible = "sunxi-pwm-regulator";
        pwms = <0x67 0x3 0x1388 0x1>;
        regulator-name = "vdd_cpu";
        regulator-min-microvolt = <0xc5c10>;
        regulator-max-microvolt = <0x11b340>;
        regulator-ramp-delay = <0x19>;
        regulator-always-on;
        regulator-boot-on;
        status = "okay";
        phandle = <0x6>;
    };
    usb1-vbus {
        compatible = "regulator-fixed";
        regulator-name = "usb1-vbus";
        regulator-min-microvolt = <0x4c4b40>;
        regulator-max-microvolt = <0x4c4b40>;
        regulator-enable-ramp-delay = <0x3e8>;
        enable-active-high;
        phandle = <0x4f>;
    };
};
