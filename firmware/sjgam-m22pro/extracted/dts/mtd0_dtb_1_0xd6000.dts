/dts-v1/;

/ {
    model = "sun8iw20";
    compatible = "allwinner,h133", "arm,sun8iw20p1";
    interrupt-parent = <0x1>;
    #address-cells = <0x2>;
    #size-cells = <0x2>;
    aliases {
        serial0 = "/soc@3000000/uart@2500000";
        serial1 = "/soc@3000000/uart@2500400";
        serial2 = "/soc@3000000/uart@2500800";
        serial3 = "/soc@3000000/uart@2500c00";
        serial4 = "/soc@3000000/uart@2501000";
        serial5 = "/soc@3000000/uart@2501400";
        spi0 = "/soc@3000000/spi@4025000";
        spi1 = "/soc@3000000/spi@4026000";
        twi0 = "/soc@3000000/twi@2502000";
        twi1 = "/soc@3000000/twi@2502400";
        twi2 = "/soc@3000000/twi@2502800";
        twi3 = "/soc@3000000/twi@2502c00";
        mmc0 = "/soc@3000000/sdmmc@4020000";
        mmc2 = "/soc@3000000/sdmmc@4022000";
        pwm = "/soc@3000000/pwm@2000c00";
        pwm0 = "/soc@3000000/pwm0@2000c10";
        pwm1 = "/soc@3000000/pwm1@2000c11";
        pwm2 = "/soc@3000000/pwm2@2000c12";
        pwm3 = "/soc@3000000/pwm3@2000c13";
        pwm4 = "/soc@3000000/pwm4@2000c14";
        pwm5 = "/soc@3000000/pwm5@2000c15";
        pwm6 = "/soc@3000000/pwm6@2000c16";
        pwm7 = "/soc@3000000/pwm7@2000c17";
        ir0 = "/soc@3000000/s_cir@7040000";
        tv0 = "/soc@3000000/tv0@5600000";
        tvd = "/soc@3000000/tvd@05c00000";
        tvd0 = "/soc@3000000/tvd0@05c01000";
        share_space0 = "/share_space@0x42100000";
    };
    chosen {
        bootargs = "earlyprintk=sunxi-uart,0x2500000 loglevel=8 initcall_debug=0 console=ttyS0 init=/init";
        linux,initrd-start = <0x0 0x0>;
        linux,initrd-end = <0x0 0x0>;
    };
    firmware {
        optee {
            compatible = "linaro,optee-tz";
            method = "smc";
        };
    };
    cpus {
        enable-method = "allwinner,sun8iw20p1";
        #address-cells = <0x1>;
        #size-cells = <0x0>;
        cpu@0 {
            device_type = "cpu";
            compatible = "arm,cortex-a7", "arm,armv7";
            reg = <0x0>;
            enable-method = "psci";
            clocks = <0x2 0x16>;
            dynamic-power-coefficient = <0x9c>;
            cpu-idle-states = <0x3 0x4>;
            operating-points-v2 = <0x5>;
            #cooling-cells = <0x2>;
            cpu-supply = <0x6>;
            phandle = <0xc>;
        };
        cpu@1 {
            device_type = "cpu";
            compatible = "arm,cortex-a7", "arm,armv7";
            reg = <0x1>;
            enable-method = "psci";
            clocks = <0x2 0x16>;
            cpu-idle-states = <0x3 0x4>;
            operating-points-v2 = <0x5>;
            #cooling-cells = <0x2>;
        };
        idle-states {
            entry-method = "arm,psci";
            cpu-sleep {
                compatible = "arm,idle-state";
                arm,psci-suspend-param = <0x10000>;
                entry-latency-us = <0x2e>;
                exit-latency-us = <0x3b>;
                min-residency-us = <0xdf2>;
                local-timer-stop;
                phandle = <0x3>;
            };
            cluster-sleep {
                compatible = "arm,idle-state";
                arm,psci-suspend-param = <0x1010000>;
                entry-latency-us = <0x2f>;
                exit-latency-us = <0x4a>;
                min-residency-us = <0x1388>;
                local-timer-stop;
                phandle = <0x4>;
            };
        };
    };
    psci {
        compatible = "arm,psci-1.0";
        method = "smc";
    };
    dump_reg@20000 {
        compatible = "allwinner,sunxi-dump-reg";
        reg = <0x0 0x20000 0x0 0x4>;
    };
    cpu-opp-table {
        compatible = "allwinner,sun50i-operating-points";
        nvmem-cells = <0x7 0x8>;
        nvmem-cell-names = "speed", "bin";
        opp-shared;
        phandle = <0x5>;
        opp@480000000 {
            opp-hz = <0x0 0x1c9c3800>;
            clock-latency-ns = <0x3b9b0>;
            opp-microvolt-a0 = <0xe7ef0>;
            opp-microvolt-a1 = <0xe7ef0>;
            opp-microvolt-b0 = <0xe7ef0>;
            opp-supported-hw = <0x3>;
        };
        opp@720000000 {
            opp-hz = <0x0 0x2aea5400>;
            clock-latency-ns = <0x3b9b0>;
            opp-microvolt-a0 = <0xe7ef0>;
            opp-microvolt-a1 = <0xe7ef0>;
            opp-microvolt-b0 = <0xe7ef0>;
            opp-supported-hw = <0x3>;
        };
        opp@912000000 {
            opp-hz = <0x0 0x365c0400>;
            clock-latency-ns = <0x3b9b0>;
            opp-microvolt-a0 = <0xe7ef0>;
            opp-microvolt-a1 = <0xe7ef0>;
            opp-microvolt-b0 = <0xe7ef0>;
            opp-supported-hw = <0x3>;
        };
        opp@1008000000 {
            opp-hz = <0x0 0x3c14dc00>;
            clock-latency-ns = <0x3b9b0>;
            opp-microvolt-a0 = <0xf4240>;
            opp-microvolt-a1 = <0xdbba0>;
            opp-microvolt-b0 = <0xe7ef0>;
            opp-supported-hw = <0x3>;
        };
        opp@1104000000 {
            opp-hz = <0x0 0x41cdb400>;
            clock-latency-ns = <0x3b9b0>;
            opp-microvolt-a0 = <0x100590>;
            opp-microvolt-a1 = <0xe7ef0>;
            opp-microvolt-b0 = <0xe7ef0>;
            opp-supported-hw = <0x3>;
        };
        opp@1200000000 {
            opp-hz = <0x0 0x47868c00>;
            clock-latency-ns = <0x3b9b0>;
            opp-microvolt-a0 = <0x10c8e0>;
            opp-microvolt-a1 = <0xf4240>;
            opp-supported-hw = <0x3>;
        };
    };
    dcxo24M_clk {
        #clock-cells = <0x0>;
        compatible = "fixed-clock";
        clock-frequency = <0x16e3600>;
        clock-output-names = "dcxo24M";
        phandle = <0xd>;
    };
    rc16m_clk {
        #clock-cells = <0x0>;
        compatible = "fixed-clock";
        clock-frequency = <0xf42400>;
        clock-accuracy = <0x11e1a300>;
        clock-output-names = "rc-16m";
    };
    ext32k_clk {
        #clock-cells = <0x0>;
        compatible = "fixed-clock";
        clock-frequency = <0x8000>;
        clock-output-names = "ext-32k";
    };
    dram {
        compatible = "allwinner,dram";
        clocks = <0x2 0x2>;
        clock-names = "pll_ddr";
    };
    memory@40000000 {
        device_type = "memory";
        reg = <0x0 0x40000000 0x0 0x20000000>;
    };
    share_space@0x42100000 {
        #address-cells = <0x1>;
        #size-cells = <0x1>;
        deice_tpye = "share_space0";
        reg = <0x42100000 0x1000 0x42101000 0x2000 0x42102000 0xe000 0x0 0x0>;
    };
    interrupt-controller@3020000 {
        compatible = "arm,cortex-a15-gic", "arm,cortex-a9-gic";
        #interrupt-cells = <0x3>;
        #address-cells = <0x0>;
        device_type = "gic";
        interrupt-controller;
        reg = <0x0 0x3021000 0x0 0x1000 0x0 0x3022000 0x0 0x2000 0x0 0x3024000 0x0 0x2000 0x0 0x3026000 0x0 0x2000>;
        interrupts = <0x1 0x9 0xf04>;
        phandle = <0x1>;
    };
    timer_arch {
        compatible = "arm,armv7-timer";
        interrupts = <0x1 0xd 0x308 0x1 0xe 0x308 0x1 0xb 0x308 0x1 0xa 0x308>;
        clock-frequency = <0x16e3600>;
        arm,cpu-registers-not-fw-configured;
        interrupt-parent = <0x1>;
        arm,no-tick-in-suspend;
    };
    pmu {
        compatible = "arm,cortex-a7-pmu";
        interrupts = <0x0 0xac 0x4 0x0 0xad 0x4>;
    };
    power-management@ff000000 {
        compatible = "allwinner,r528-pmu", "syscon", "simple-mfd";
        reg = <0x0 0x7001000 0x0 0x400>;
        power-controller {
            compatible = "allwinner,r528-power-controller";
            clocks = <0x9 0x4>;
            clock-names = "ppu";
            resets = <0x9 0x2>;
            reset-names = "ppu_rst";
            #power-domain-cells = <0x1>;
            #address-cells = <0x1>;
            #size-cells = <0x0>;
            pd_ve@1 {
                reg = <0x1>;
            };
        };
    };
    iommu@2010000 {
        compatible = "allwinner,sunxi-iommu";
        reg = <0x0 0x2010000 0x0 0x1000>;
        interrupts = <0x0 0x40 0x4>;
        interrupt-names = "iommu-irq";
        clocks = <0x2 0x30>;
        clock-names = "iommu";
        #iommu-cells = <0x2>;
        status = "okay";
        phandle = <0x2c>;
    };
    pio-18 {
        compatible = "regulator-fixed";
        regulator-name = "pio-18";
        regulator-min-microvolt = <0x1b7740>;
        regulator-max-microvolt = <0x1b7740>;
        phandle = <0xf>;
    };
    pio-33 {
        compatible = "regulator-fixed";
        regulator-name = "pio-33";
        regulator-min-microvolt = <0x325aa0>;
        regulator-max-microvolt = <0x325aa0>;
        phandle = <0x10>;
    };
    thermal-zones {
        cpu_thermal_zone {
            polling-delay-passive = <0x1f4>;
            polling-delay = <0x3e8>;
            thermal-sensors = <0xa 0x0>;
            sustainable-power = <0x24d>;
            trips {
                trip-point@0 {
                    temperature = <0x11170>;
                    type = "passive";
                    hysteresis = <0x0>;
                };
                trip-point@1 {
                    temperature = <0x15f90>;
                    type = "passive";
                    hysteresis = <0x0>;
                    phandle = <0xb>;
                };
                cpu_crit@0 {
                    temperature = <0x1c138>;
                    type = "critical";
                    hysteresis = <0x0>;
                };
            };
            cooling-maps {
                map0 {
                    trip = <0xb>;
                    cooling-device = <0xc 0xffffffff 0xffffffff>;
                    contribution = <0x400>;
                };
            };
        };
    };
    soc@3000000 {
        compatible = "simple-bus";
        #address-cells = <0x2>;
        #size-cells = <0x2>;
        ranges;
        device_type = "soc";
        sram_ctrl@3000000 {
            compatible = "allwinner,sram_ctrl";
            reg = <0x0 0x3000000 0x0 0x16c>;
            soc_ver {
                offset = <0x24>;
                mask = <0x7>;
                shift = <0x0>;
                ver_a = <0x18590000>;
                ver_b = <0x18590002>;
            };
            soc_id {
                offset = <0x200>;
                mask = <0x1>;
                shift = <0x16>;
            };
            soc_bin {
                offset = <0x0>;
                mask = <0x3ff>;
                shift = <0x0>;
            };
        };
        rtc_ccu@7090000 {
            compatible = "allwinner,sun8iw20-rtc-ccu";
            device_type = "rtc-ccu";
            reg = <0x0 0x7090000 0x0 0x320>;
            #clock-cells = <0x1>;
            phandle = <0xe>;
        };
        ccu@2001000 {
            compatible = "allwinner,sun8iw20-ccu";
            reg = <0x0 0x2001000 0x0 0x1000>;
            clocks = <0xd 0xe 0x3 0xe 0x0>;
            clock-names = "hosc", "losc", "iosc";
            #clock-cells = <0x1>;
            #reset-cells = <0x1>;
            phandle = <0x2>;
        };
        r_ccu@7010000 {
            compatible = "allwinner,sun8iw20-r-ccu";
            reg = <0x0 0x7010000 0x0 0x240>;
            clocks = <0xd 0xe 0x3 0xe 0x0 0x2 0x4>;
            clock-names = "hosc", "losc", "iosc", "pll-periph0";
            #clock-cells = <0x1>;
            #reset-cells = <0x1>;
            phandle = <0x9>;
        };
        rtc@7090000 {
            compatible = "allwinner,sun8iw20-rtc";
            device_type = "rtc";
            wakeup-source;
            reg = <0x0 0x7090000 0x0 0x320>;
            interrupts = <0x0 0x90 0x4>;
            clocks = <0x9 0x7 0xe 0x6 0xe 0x8>;
            clock-names = "r-ahb-rtc", "rtc-1k", "rtc-spi";
            resets = <0x9 0x4>;
            gpr_cur_pos = <0x6>;
        };
        dma-controller@3002000 {
            compatible = "allwinner,sun8iw20-dma";
            reg = <0x0 0x3002000 0x0 0x1000>;
            interrupts = <0x0 0x32 0x4>;
            clocks = <0x2 0x27 0x2 0x32>;
            clock-names = "bus", "mbus";
            dma-channels = <0x8>;
            dma-requests = <0x30>;
            resets = <0x2 0x6>;
            #dma-cells = <0x1>;
            phandle = <0x25>;
        };
        timer@2050000 {
            compatible = "allwinner,sun4i-a10-timer";
            device_type = "soc_timer";
            reg = <0x0 0x2050000 0x0 0xa0>;
            interrupt-parent = <0x1>;
            interrupts = <0x0 0x3b 0x4>;
            clocks = <0xd>;
        };
        watchdog@20500A0 {
            compatible = "allwinner,sun6i-a31-wdt";
            reg = <0x0 0x20500a0 0x0 0x20>;
            interrupts = <0x0 0x3f 0x4>;
        };
        mbus-controller@3102000 {
            compatible = "allwinner,sun8i-mbus";
            reg = <0x0 0x3102000 0x0 0x1000>;
            #mbus-cells = <0x1>;
        };
        pinctrl@2000000 {
            compatible = "allwinner,sun8iw20-pinctrl";
            reg = <0x0 0x2000000 0x0 0x500>;
            interrupts = <0x0 0x45 0x4 0x0 0x47 0x4 0x0 0x49 0x4 0x0 0x4b 0x4 0x0 0x4d 0x4 0x0 0x4f 0x4>;
            device_type = "pio";
            clocks = <0x2 0x1a 0xd 0xe 0x3>;
            clock-names = "apb", "hosc", "losc";
            gpio-controller;
            #gpio-cells = <0x3>;
            interrupt-controller;
            #interrupt-cells = <0x3>;
            #size-cells = <0x0>;
            vcc-pf-supply = <0xf>;
            vcc-pfo-supply = <0x10>;
            vcc-pg-supply = <0xf>;
            phandle = <0x13>;
            test_pins@0 {
                allwinner,pins = "PB0", "PB1";
                allwinner,function = "test";
                allwinner,muxsel = <0x9>;
                allwinner,drive = <0x1>;
                allwinner,pull = <0x1>;
                phandle = <0x11>;
            };
            test_pins@1 {
                pins = "PB0", "PB1";
                function = "io_disabled";
                allwinner,muxsel = <0xf>;
                allwinner,drive = <0x1>;
                allwinner,pull = <0x1>;
                phandle = <0x12>;
            };
            csi_mclk0@0 {
                pins = "PE3";
                function = "csi0";
                drive-strength = <0xa>;
                phandle = <0x43>;
            };
            csi_mclk0@1 {
                pins = "PE3";
                function = "gpio_in";
                phandle = <0x44>;
            };
            csi0@0 {
                pins = "PE2", "PE0", "PE1", "PE4", "PE5", "PE6", "PE7", "PE8", "PE9", "PE10", "PE11";
                function = "ncsi0";
                drive-strength = <0xa>;
                phandle = <0x45>;
            };
            csi0@1 {
                pins = "PE2", "PE0", "PE1", "PE4", "PE5", "PE6", "PE7", "PE8", "PE9", "PE10", "PE11";
                function = "io_disabled";
                drive-strength = <0xa>;
                phandle = <0x46>;
            };
            lvds0@0 {
                pins = "PD0", "PD1", "PD2", "PD3", "PD4", "PD5", "PD6", "PD7", "PD8", "PD9";
                function = "lvds0";
                drive-strength = <0x1e>;
                bias-disable;
            };
            lvds0@1 {
                pins = "PD0", "PD1", "PD2", "PD3", "PD4", "PD5", "PD6", "PD7", "PD8", "PD9";
                function = "io_disabled";
                drive-strength = <0x1e>;
                bias-disable;
            };
            rgb24@0 {
                pins = "PB2", "PB3", "PD0", "PD1", "PD2", "PD3", "PD4", "PD5", "PB4", "PB5", "PD6", "PD7", "PD8", "PD9", "PD10", "PD11", "PB6", "PB7", "PD12", "PD13", "PD14", "PD15", "PD16", "PD17", "PD18", "PD19", "PD20", "PD21";
                function = "lcd0";
                drive-strength = <0x1e>;
                bias-disable;
            };
            rgb24@1 {
                pins = "PB2", "PB3", "PD0", "PD1", "PD2", "PD3", "PD4", "PD5", "PB4", "PB5", "PD6", "PD7", "PD8", "PD9", "PD10", "PD11", "PB6", "PB7", "PD12", "PD13", "PD14", "PD15", "PD16", "PD17", "PD18", "PD19", "PD20", "PD21";
                function = "io_disabled";
                bias-disable;
            };
            rgb18@0 {
                pins = "PD0", "PD1", "PD2", "PD3", "PD4", "PD5", "PD6", "PD7", "PD8", "PD9", "PD10", "PD11", "PD12", "PD13", "PD14", "PD15", "PD16", "PD17", "PD18", "PD19", "PD20", "PD21";
                function = "lcd0";
                drive-strength = <0x1e>;
                bias-disable;
            };
            rgb18@1 {
                pins = "PD0", "PD1", "PD2", "PD3", "PD4", "PD5", "PD6", "PD7", "PD8", "PD9", "PD10", "PD11", "PD12", "PD13", "PD14", "PD15", "PD16", "PD17", "PD18", "PD19", "PD20", "PD21";
                function = "io_disabled";
                bias-disable;
            };
            dsi4lane@0 {
                pins = "PD0", "PD1", "PD2", "PD3", "PD4", "PD5", "PD6", "PD7", "PD8", "PD9";
                function = "dsi";
                drive-strength = <0x1e>;
                bias-disable;
                allwinner,pins = "PD0", "PD1", "PD2", "PD3", "PD4", "PD5", "PD6", "PD7", "PD8", "PD9";
                allwinner,pname = "PD0", "PD1", "PD2", "PD3", "PD4", "PD5", "PD6", "PD7", "PD8", "PD9";
                allwinner,function = "dsi";
                allwinner,muxsel = <0x4>;
                allwinner,drive = <0x3>;
                allwinner,pull = <0x0>;
                phandle = <0x4d>;
            };
            dsi4lane@1 {
                pins = "PD0", "PD1", "PD2", "PD3", "PD4", "PD5", "PD6", "PD7", "PD8", "PD9";
                function = "io_disabled";
                bias-disable;
                allwinner,pins = "PD0", "PD1", "PD2", "PD3", "PD4", "PD5", "PD6", "PD7", "PD8", "PD9";
                allwinner,pname = "PD0", "PD1", "PD2", "PD3", "PD4", "PD5", "PD6", "PD7", "PD8", "PD9";
                allwinner,function = "io_disabled";
                allwinner,muxsel = <0x7>;
                allwinner,drive = <0x3>;
                allwinner,pull = <0x0>;
                phandle = <0x4e>;
            };
            sdc0@0 {
                allwinner,pins = "PF0", "PF1", "PF2", "PF3", "PF4", "PF5";
                allwinner,function = "sdc0";
                allwinner,muxsel = <0x2>;
                allwinner,drive = <0x3>;
                allwinner,pull = <0x1>;
                pins = "PF0", "PF1", "PF2", "PF3", "PF4", "PF5";
                function = "sdc0";
                drive-strength = <0x1e>;
                bias-pull-up;
                power-source = <0xce4>;
                phandle = <0x1e>;
            };
            sdc0@1 {
                pins = "PF0", "PF1", "PF2", "PF3", "PF4", "PF5";
                function = "sdc0";
                drive-strength = <0x1e>;
                bias-pull-up;
                power-source = <0x708>;
                phandle = <0x1f>;
            };
            sdc0@2 {
                pins = "PF0", "PF1", "PF2", "PF3", "PF4", "PF5";
                function = "gpio_in";
                phandle = <0x20>;
            };
            sdc0@3 {
                pins = "PF2", "PF4";
                function = "uart0";
                drive-strength = <0xa>;
                bias-pull-up;
                phandle = <0x21>;
            };
            sdc0@4 {
                pins = "PF0", "PF1", "PF3", "PF5";
                function = "jtag";
                drive-strength = <0xa>;
                bias-pull-up;
                phandle = <0x22>;
            };
            sdc1@0 {
                pins = "PG0", "PG1", "PG2", "PG3", "PG4", "PG5";
                function = "sdc1";
                drive-strength = <0x1e>;
                bias-pull-up;
                phandle = <0x23>;
            };
            sdc1@1 {
                pins = "PG0", "PG1", "PG2", "PG3", "PG4", "PG5";
                function = "gpio_in";
                phandle = <0x24>;
            };
            sdc2@0 {
                allwinner,pins = "PC2", "PC3", "PC4", "PC5", "PC6", "PC7";
                allwinner,function = "sdc2";
                allwinner,muxsel = <0x3>;
                allwinner,drive = <0x3>;
                allwinner,pull = <0x1>;
                pins = "PC2", "PC3", "PC4", "PC5", "PC6", "PC7";
                function = "sdc2";
                drive-strength = <0x1e>;
                bias-pull-up;
                phandle = <0x1c>;
            };
            sdc2@1 {
                pins = "PC2", "PC3", "PC4", "PC5", "PC6", "PC7";
                function = "gpio_in";
                phandle = <0x1d>;
            };
            wlan@0 {
                pins = "PG11";
                function = "clk_fanout1";
                phandle = <0x66>;
            };
            uart0_pins@0 {
                pins = "PB8", "PB9";
                function = "uart0";
                drive-strength = <0xa>;
                bias-pull-up;
                phandle = <0x14>;
            };
            uart0_pins@1 {
                pins = "PB8", "PB9";
                function = "gpio_in";
                phandle = <0x15>;
            };
            uart1_pins@0 {
                pins = "PG6", "PG7", "PG8", "PG9";
                function = "uart1";
                drive-strength = <0xa>;
                bias-pull-up;
                phandle = <0x16>;
            };
            uart1_pins@1 {
                pins = "PG6", "PG7", "PG8", "PG9";
                function = "gpio_in";
